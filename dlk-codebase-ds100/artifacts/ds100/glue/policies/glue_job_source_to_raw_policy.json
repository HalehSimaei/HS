{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:*Object*"
            ],
            "Resource": [
                "arn:aws:s3:::stg-dlk-${env}-ds-${ds_id}-raw/*",
                "arn:aws:s3:::${bucket_artifacts}/*"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": [
                "arn:aws:s3:::stg-dlk-${env}-ds-${ds_id}-raw",
                "arn:aws:s3:::${bucket_artifacts}"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "lakeformation:GetDataAccess",
                "glue:GetSecurityConfiguration",
                "ec2:DescribeSubnets",
                "ec2:DescribeSecurityGroups",
                "ec2:DescribeVpcEndpoints",
                "ec2:DescribeRouteTables",
                "ec2:DescribeNetworkInterfaces",
                "ec2:CreateNetworkInterface",
                "ec2:AttachNetworkInterface",
                "ec2:DeleteNetworkInterface",
                "ec2:DescribeInstances",
                "ec2:CreateTags"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Action": [
                "kms:Describe*",
                "kms:Get*",
                "kms:List*",
                "kms:Encrypt",
                "kms:Decrypt",
                "kms:GenerateDataKey"
            ],
            "Effect": "Allow",
            "Resource": "${kms_key_arn}"
        },
        {
            "Action": [
                "logs:*"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:logs:eu-west-1:${account_id}:log-group:/aws-glue/jobs/*"
        },
        {
            "Action": [
                "glue:GetTables",
                "glue:GetTable",
                "glue:UpdateTable",
                "glue:CreateDatabase",
                "glue:GetDatabase",
                "glue:GetDatabases",
                "glue:GetPartitions",
                "glue:GetTableVersion",
                "glue:GetTableVersions",
                "glue:UpdateTableVersion",
                "glue:CreateTable",
                "glue:DeleteTable",
                "glue:BatchCreatePartition",
                "glue:GetConnection"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:glue:eu-west-1:${account_id}:database/${db_name}",
                "arn:aws:glue:eu-west-1:${account_id}:catalog",
                "arn:aws:glue:eu-west-1:${account_id}:table/${db_name}/*",
                "arn:aws:glue:eu-west-1:${account_id}:connection/stg-dlk-${env}-ds${ds_id}-network-connection",
                "arn:aws:glue:eu-west-1:${account_id}:connection/stg-dlk-${env}-ds${ds_id}-historical-network-connection"
            ]
        },
        {
            "Action": [
                "secretsmanager:GetSecretValue"
            ],
            "Effect": "Allow",
            "Resource": [
                "${secret_param}"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
              "ssm:GetParameter",
              "ssm:PutParameter"
            ],
            "Resource": [

              "arn:aws:ssm:eu-west-1:${account_id}:parameter/stg-dlk-${env}/ds${ds_id}/helpscout/customers/last_updated"

            ]
          }
    ]
}

